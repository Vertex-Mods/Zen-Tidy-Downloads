[
  {
    "type": "separator",
    "label": "AI Renaming"
  },
  {
    "property": "extensions.downloads.ai_provider",
    "label": "AI service",
    "type": "dropdown",
    "defaultValue": "mistral",
    "options": [
      {
        "label": "Mistral AI",
        "value": "mistral"
      },
      {
        "label": "OpenAI-compatible endpoint",
        "value": "openai_compat"
      }
    ]
  },
  {
    "property": "extensions.downloads.mistral_api_key",
    "label": "Mistral API key",
    "type": "string",
    "placeholder": "Enter your Mistral API key",
    "conditions": [
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "mistral"
        }
      }
    ]
  },
  {
    "property": "extensions.downloads.mistral_model",
    "label": "Mistral model",
    "type": "string",
    "placeholder": "mistral-small-latest",
    "defaultValue": "mistral-small-latest",
    "conditions": [
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "mistral"
        }
      }
    ]
  },
  {
    "property": "extensions.downloads.openai_compat_api_key",
    "label": "Endpoint API key",
    "type": "string",
    "placeholder": "Paste your OpenRouter or compatible API key",
    "conditions": [
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "openai_compat"
        }
      }
    ]
  },
  {
    "property": "extensions.downloads.openai_compat_base_url",
    "label": "Endpoint base URL",
    "type": "string",
    "placeholder": "https://openrouter.ai/api/v1",
    "defaultValue": "https://openrouter.ai/api/v1",
    "conditions": [
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "openai_compat"
        }
      }
    ]
  },
  {
    "property": "extensions.downloads.openai_compat_model",
    "label": "Endpoint model ID",
    "type": "string",
    "placeholder": "openai/gpt-4.1-mini",
    "defaultValue": "openai/gpt-4.1-mini",
    "conditions": [
      {
        "if": {
          "property": "extensions.downloads.ai_provider",
          "value": "openai_compat"
        }
      }
    ]
  },
  {
    "type": "separator",
    "label": "Download Behavior"
  },
  {
    "property": "extensions.downloads.enable_ai_renaming",
    "type": "checkbox",
    "label": "Enable AI-powered file renaming",
    "defaultValue": true
  },
  {
    "type": "separator",
    "label": "Debugging"
  },
  {
    "property": "extensions.downloads.enable_debug",
    "type": "checkbox",
    "label": "Enable debugging logs in browser console (Ctrl + Shift + J)",
    "defaultValue": false
  },
  {
    "property": "extensions.downloads.debug_ai_only",
    "type": "checkbox",
    "label": "Show only AI renaming debug logs (requires debug enabled)",
    "defaultValue": true
  }
]
